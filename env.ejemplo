# Evolve Soluciones - Configuración de Variables de Entorno
# =========================================================

# CONFIGURACIÓN GENERAL
FLASK_ENV=desarrollo
FLASK_DEBUG=True
SECRET_KEY=tu-clave-secreta-super-segura-2024

# BASE DE DATOS POSTGRESQL (Sistema de Autenticación)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-postgres
POSTGRES_DB=evolve_auth
POSTGRES_PORT=5432

# BASE DE DATOS LOCAL (MySQL - Gestión Empresarial)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=tu-password-local
DB_NAME=evolve
DB_PORT=3306

# BASE DE DATOS REMOTA (Para consolidados)
REMOTE_DB_HOST=192.168.0.2
REMOTE_DB_USER=usuario-remoto
REMOTE_DB_PASSWORD=password-remoto
REMOTE_DB_NAME=evolve
REMOTE_DB_PORT=3306

# CONEXIÓN A VICAT (servidor central para algunos procesos)
# Rellena estas variables en tu `.env` si deseas que los endpoints de
# asignación se ejecuten contra el servidor Vicat.
DB_HOST_Vicat=vicat.audisoft.cl
DB_USER_Vicat=audytax
DB_PASSWORD_Vicat=2904
DB_NAME_Vicat=evolve
DB_PORT_Vicat=3306

# Schema objetivo para las operaciones de asignación (si no se define,
# se usará DB_NAME_Vicat o DB_NAME según la prioridad en el código)
ASIGNACION_DB=evolve
ASIGNACION_PAGOS_DB=evolve

# MONGODB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=consolidado_archivos

# API DE GOOGLE SHEETS
GOOGLE_SHEETS_CREDENTIALS_FILE=credenciales.json
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets

# API DE GOOGLE GEMINI
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT=120

# CONFIGURACIÓN DE ARCHIVOS
MAX_CONTENT_LENGTH=16777216
UPLOAD_EXTENSIONS=.xls,.xlsx,.csv

# CONFIGURACIÓN DE SESIONES
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_DURATION=86400

# CONFIGURACIÓN CSRF
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600
WTF_CSRF_SSL_STRICT=False
