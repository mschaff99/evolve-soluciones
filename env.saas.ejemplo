# =====================================================
# CONFIGURACIÓN SAAS - EVOLVE SOLUCIONES
# =====================================================
# Copia este archivo a .env y configura tus valores
# =====================================================

# =====================================================
# CONFIGURACIÓN GENERAL
# =====================================================
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion

# =====================================================
# BASE DE DATOS
# =====================================================

# PostgreSQL (Autenticación y Suscripciones)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-postgres
POSTGRES_DB=evolve

# MySQL (Datos de Clientes/Tenants)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=tu-password-mysql
DB_PORT=3306

# Base de datos remota (opcional)
REMOTE_DB_HOST=192.168.0.2
REMOTE_DB_USER=usuario-remoto
REMOTE_DB_PASSWORD=password-remoto

# =====================================================
# STRIPE (PASARELA DE PAGO INTERNACIONAL)
# =====================================================

# Claves de Modo Test (Desarrollo)
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Claves de Modo Live (Producción)
# STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE
# STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SECRET_HERE

# =====================================================
# MERCADOPAGO (PASARELA DE PAGO LATAM)
# =====================================================

# Credenciales de Test (Desarrollo)
MERCADOPAGO_ACCESS_TOKEN=TEST-YOUR_ACCESS_TOKEN_HERE
MERCADOPAGO_PUBLIC_KEY=TEST-YOUR_PUBLIC_KEY_HERE

# Credenciales de Producción
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-YOUR_ACCESS_TOKEN_HERE
# MERCADOPAGO_PUBLIC_KEY=APP_USR-YOUR_PUBLIC_KEY_HERE

# =====================================================
# WEBPAY PLUS (TRANSBANK CHILE - FUTURO)
# =====================================================

# WEBPAY_COMMERCE_CODE=597055555532
# WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# WEBPAY_ENVIRONMENT=integration  # integration o production

# =====================================================
# CONFIGURACIÓN SAAS
# =====================================================

# Período de prueba por defecto (días)
SAAS_TRIAL_DAYS=14

# Plan por defecto para nuevos clientes
SAAS_DEFAULT_PLAN=basico

# Pasarela de pago por defecto
SAAS_DEFAULT_GATEWAY=stripe  # stripe, mercadopago, webpay

# Moneda por defecto
SAAS_DEFAULT_CURRENCY=CLP  # CLP, USD, EUR

# Activar modo sandbox/test
SAAS_SANDBOX_MODE=True  # True en desarrollo, False en producción

# URL base del sistema (para callbacks)
SAAS_BASE_URL=https://evolve-soluciones.com

# =====================================================
# EMAIL Y NOTIFICACIONES
# =====================================================

# SMTP para envío de emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-email

# SendGrid (alternativa recomendada)
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE

# Mailgun (alternativa)
# MAILGUN_API_KEY=key-YOUR_MAILGUN_API_KEY_HERE
# MAILGUN_DOMAIN=mg.evolve-soluciones.com

# Emails del sistema
MAIL_FROM_ADDRESS=noreply@evolve-soluciones.com
MAIL_FROM_NAME=Evolve Soluciones
MAIL_SUPPORT_ADDRESS=soporte@evolve-soluciones.com
MAIL_SALES_ADDRESS=ventas@evolve-soluciones.com

# =====================================================
# FACTURACIÓN ELECTRÓNICA (SII CHILE)
# =====================================================

# Credenciales SII
SII_RUT=76xxxxxx-x
SII_PASSWORD=tu-password-sii
SII_AMBIENTE=certificacion  # certificacion o produccion

# Folios DTE
DTE_FOLIO_FACTURA_DESDE=1
DTE_FOLIO_FACTURA_HASTA=1000

# =====================================================
# ANALYTICS Y MONITORING
# =====================================================

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry (Monitoreo de Errores)
SENTRY_DSN=https://YOUR_SENTRY_DSN_HERE@o0000000.ingest.sentry.io/0000000

# New Relic
# NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY_HERE
# NEW_RELIC_APP_NAME=Evolve Soluciones

# Mixpanel (Product Analytics)
# MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN_HERE

# =====================================================
# APIS EXTERNAS (EXISTENTES)
# =====================================================

# Google AI (Gemini)
GEMINI_API_KEY=tu-api-key-de-gemini

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=credenciales.json

# =====================================================
# SEGURIDAD
# =====================================================

# JWT Secret para API
JWT_SECRET_KEY=otra-clave-secreta-diferente-para-jwt

# Tiempo de expiración de sesión (segundos)
SESSION_LIFETIME=86400  # 24 horas

# CORS (si usas frontend separado)
CORS_ORIGINS=https://app.evolve-soluciones.com,https://evolve-soluciones.com

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=redis://localhost:6379

# =====================================================
# CACHE (REDIS - OPCIONAL)
# =====================================================

# REDIS_URL=redis://localhost:6379/0
# CACHE_TYPE=redis
# CACHE_DEFAULT_TIMEOUT=300

# =====================================================
# LOGGING
# =====================================================

# Nivel de log
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Archivo de log
LOG_FILE=logs/evolve-saas.log

# Log a stdout
LOG_TO_CONSOLE=True

# =====================================================
# BACKUP Y ALMACENAMIENTO
# =====================================================

# AWS S3 (para backups y archivos)
# AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY_HERE
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
# AWS_S3_BUCKET=evolve-backups
# AWS_REGION=us-east-1

# Ruta local para backups
BACKUP_PATH=/var/backups/evolve

# Frecuencia de backup automático (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Diario a las 2 AM

# =====================================================
# DESARROLLO Y DEBUG
# =====================================================

# Activar modo debug (NUNCA en producción)
DEBUG_MODE=False

# Toolbar de Flask Debug
DEBUG_TB_ENABLED=False

# Profiling
PROFILING_ENABLED=False

# =====================================================
# FEATURES FLAGS
# =====================================================

# Activar/desactivar funcionalidades
FEATURE_WEBPAY=False
FEATURE_FACTURACION_ELECTRONICA=False
FEATURE_API_PUBLICA=False
FEATURE_MOBILE_APP=False
FEATURE_REFERRAL_PROGRAM=False

# =====================================================
# LÍMITES POR DEFECTO (SI NO ESTÁN EN PLAN)
# =====================================================

DEFAULT_MAX_USERS=3
DEFAULT_MAX_COMPANIES=15
DEFAULT_MAX_TRANSACTIONS_MONTH=500
DEFAULT_STORAGE_GB=5

# =====================================================
# SOPORTE Y AYUDA
# =====================================================

SUPPORT_EMAIL=soporte@evolve-soluciones.com
SUPPORT_PHONE=+56912345678
DOCUMENTATION_URL=https://docs.evolve-soluciones.com
STATUS_PAGE_URL=https://status.evolve-soluciones.com

# =====================================================
# LEGAL
# =====================================================

TERMS_OF_SERVICE_URL=https://evolve-soluciones.com/terminos
PRIVACY_POLICY_URL=https://evolve-soluciones.com/privacidad
COMPANY_NAME=Evolve Soluciones SpA
COMPANY_RUT=76xxxxxx-x
COMPANY_ADDRESS=Dirección Empresa, Santiago, Chile

# =====================================================
# NOTAS IMPORTANTES
# =====================================================
# 
# 1. NUNCA commitear este archivo con valores reales a Git
# 2. En producción, usar variables de entorno del sistema
# 3. Rotar claves periódicamente
# 4. Usar secretos diferentes para cada entorno
# 5. Mantener backup cifrado de credenciales
#
# =====================================================
