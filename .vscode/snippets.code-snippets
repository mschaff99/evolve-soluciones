    "Clase Servicio": {
        "prefix": "servicio-clase",
        "body": [
            "from typing import Optional, Dict, List",
            "from aplicacion.modelos.base_datos import ejecutar_consulta",
            "",
            "class ${1:NombreServicio}:",
            "    \"\"\"${2:Descripción del servicio}\"\"\"",
            "    ",
            "    @staticmethod",
            "    def obtener_por_id(id_${3:entidad}: int) -> Optional[Dict]:",
            "        \"\"\"",
            "        Obtiene ${3:entidad} por ID",
            "        ",
            "        Args:",
            "            id_${3:entidad}: ID de la ${3:entidad}",
            "            ",
            "        Returns:",
            "            Dict con datos o None",
            "        \"\"\"",
            "        try:",
            "            consulta = \"SELECT * FROM ${4:tabla} WHERE id = %s\"",
            "            return ejecutar_consulta(consulta, (id_${3:entidad},), obtener_uno=True)",
            "        except Exception as e:",
            "            print(f'Error al obtener ${3:entidad}: {e}')",
            "            return None",
            "    ",
            "    @staticmethod",
            "    def listar_todos() -> List[Dict]:",
            "        \"\"\"Obtiene todas las ${3:entidad}s\"\"\"",
            "        try:",
            "            consulta = \"SELECT * FROM ${4:tabla}\"",
            "            return ejecutar_consulta(consulta)",
            "        except Exception as e:",
            "            print(f'Error al listar ${3:entidad}s: {e}')",
            "            return []",
            "    ",
            "    $0"
        ],
        "description": "Clase de servicio con métodos básicos"
    },
