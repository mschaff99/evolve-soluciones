    "Flask Blueprint": {
        "prefix": "flask-bp",
        "body": [
            "from flask import Blueprint, render_template, request, jsonify, redirect, url_for",
            "from flask_login import login_required, current_user",
            "from aplicacion.utilidades.decoradores import ${1:decorador}",
            "",
            "${2:nombre}_bp = Blueprint('${2:nombre}', __name__, url_prefix='/${3:ruta}')",
            "",
            "@${2:nombre}_bp.route('/', methods=['GET'])",
            "@login_required",
            "def ${4:vista}():",
            "    \"\"\"${5:Descripción de la vista}\"\"\"",
            "    try:",
            "        $0",
            "        return render_template('paginas/${6:template}.html')",
