    "Flask Route GET": {
        "prefix": "flask-route-get",
        "body": [
            "@${1:blueprint}_bp.route('/${2:ruta}', methods=['GET'])",
            "@login_required",
            "def ${3:nombre_funcion}():",
            "    \"\"\"${4:Descripción de la ruta}\"\"\"",
            "    try:",
            "        $0",
            "        return render_template('paginas/${5:template}.html')",
            "    except Exception as e:",
            "        print(f'Error en ${3:nombre_funcion}: {e}')",
            "        return jsonify({'error': str(e)}), 500"
