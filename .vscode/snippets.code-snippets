    "Consulta SQL Parametrizada": {
        "prefix": "sql-query",
        "body": [
            "consulta = \"\"\"",
            "    SELECT $1",
            "    FROM ${2:tabla}",
            "    WHERE ${3:condicion} = %s",
            "\"\"\"",
            "resultado = ejecutar_consulta(consulta, (${4:parametro},)$5)"
        ],
        "description": "Consulta SQL parametrizada segura"
    },
    "Transacción SQL": {
        "prefix": "sql-transaction",
        "body": [
            "try:",
            "    conexion = obtener_conexion()",
            "    cursor = conexion.cursor()",
            "    ",
            "    # Primera operación",
            "    consulta1 = \"${1:INSERT/UPDATE/DELETE...}\"",
            "    cursor.execute(consulta1, (${2:params},))",
            "    ",
            "    # Segunda operación",
            "    consulta2 = \"${3:INSERT/UPDATE/DELETE...}\"",
            "    cursor.execute(consulta2, (${4:params},))",
            "    ",
            "    conexion.commit()",
            "    return True",
            "except Exception as e:",
            "    conexion.rollback()",
            "    print(f'Error en transacción: {e}')",
            "    return False",
            "finally:",
            "    cursor.close()",
            "    conexion.close()"
        ],
        "description": "Transacción SQL con rollback"
    },
